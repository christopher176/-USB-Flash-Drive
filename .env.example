# ============================================================================
# USB Shield - example configuration template
# Copy to .env (or export in your shell / systemd unit) and adjust.
# NEVER commit a real .env file. NEVER share the agent token.
# ============================================================================

# --- Local scanning agent ---------------------------------------------------
# Directory for tokens, quarantine, reports, history DB, audit log.
USBSHIELD_DATA_DIR=~/.usb-shield

# Bind address + port for the local scanning agent API.
# SECURITY: keep this 127.0.0.1 in production. The agent must only be
# reachable from the local machine; the web UI reaches it via an
# authenticated, origin-checked channel.
USBSHIELD_BIND_HOST=127.0.0.1
USBSHIELD_PORT=8765

# Comma-separated list of browser origins allowed to talk to the agent.
# Only the official web UI origins should appear here.
USBSHIELD_ALLOWED_ORIGINS=http://localhost:3847,http://127.0.0.1:3847

# Additional Host header values the agent will accept (DNS-rebinding guard).
USBSHIELD_ALLOWED_HOSTS=

# Optional: extra directories treated as scan targets (dev/demo only).
# USBSHIELD_EXTRA_DEVICE_ROOTS=/tmp/usb-shield-demo

# Enable synthetic demo device endpoint (DEVELOPMENT ONLY - never in prod).
USBSHIELD_DEV_DEMO=false

# --- Optional user accounts (multi-user website deployments) ---------------
USBSHIELD_ACCOUNTS_ENABLED=false
# Mark session cookies Secure (requires HTTPS). Keep true in production.
USBSHIELD_SESSION_SECURE=true

# --- AV engines --------------------------------------------------------------
# ClamAV daemon socket / TCP endpoint, if installed.
USBSHIELD_CLAMD_SOCKET=
USBSHIELD_CLAMD_TCP=127.0.0.1:3310

# --- Frontend ----------------------------------------------------------------
# Vite dev-server port (the agent proxies nothing; the UI proxies /api).
VITE_PORT=3847
