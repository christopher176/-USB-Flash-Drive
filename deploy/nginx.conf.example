# USB Shield dashboard - production reverse proxy example.
# Serves the static build over HTTPS and proxies /api to the loopback agent.
# See docs/DEPLOYMENT.md section 4 before use.

limit_req_zone $binary_remote_addr zone=usbshield:10m rate=30r/m;

server {
    listen 443 ssl;
    http2 on;
    server_name usbshield.example.com;      # CHANGE ME

    ssl_certificate     /etc/letsencrypt/live/usbshield.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/usbshield.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    root /var/www/usb-shield/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # NEVER proxy the pairing endpoint publicly: the proxy's peer is loopback,
    # so /api/pair would otherwise answer for anyone on the internet and hand
    # them full control of the agent. Pair only from the machine itself.
    location = /api/pair {
        return 403;
    }

    location /api/ {
        limit_req zone=usbshield burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        # Agent's Host allowlist expects the loopback authority. The Origin
        # header is forwarded untouched so the agent can enforce its allowlist.
        proxy_set_header Host 127.0.0.1:8765;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_read_timeout 300s;
        client_max_body_size 1m;
    }
}

server {
    listen 80;
    server_name usbshield.example.com;
    return 301 https://$host$request_uri;
}
